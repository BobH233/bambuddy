# Merge these values into the service's environment.
CAMERA_HLS_ENABLED=true
UPDATES_DISABLED=true
BAMBUDDY_UI_LANGUAGE=zh-CN
TZ=Asia/Shanghai

# Keep runtime directories outside the source checkout.
# DATA_DIR=/path/to/bambuddy/data
# LOG_DIR=/path/to/bambuddy/logs

# Optional VAPID contact; HTTPS URL or mailto address.
# WEB_PUSH_CONTACT=https://bambuddy.cool
# The automatically generated VAPID private key stays in DATA_DIR.
